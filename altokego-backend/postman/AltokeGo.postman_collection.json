{
  "info": {
    "name": "AltokeGo API - Entrega 2",
    "description": "Registro, Basic Auth y roles. Ejecutar las carpetas en orden. Antes de la carpeta 5, promover al administrador de prueba en la base (ver README).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userEmail",
      "value": "usuario.prueba@altokego.test"
    },
    {
      "key": "userPassword",
      "value": "prueba123"
    },
    {
      "key": "adminEmail",
      "value": "admin.prueba@altokego.test"
    },
    {
      "key": "adminPassword",
      "value": "admin123"
    },
    {
      "key": "pasajeroId",
      "value": "1"
    },
    {
      "key": "viajeId",
      "value": "1"
    },
    {
      "key": "pasajeroEmail",
      "value": "ana.perez@mail.com"
    }
  ],
  "item": [
    {
      "name": "1. Registro de usuarios (público)",
      "item": [
        {
          "name": "Registrar usuario válido sin autenticación (201)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Prueba\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Si el usuario ya fue registrado en una ejecución anterior, responde 409 (ver la prueba siguiente)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const cuerpo = pm.response.text();",
                  "pm.test(\"La respuesta no expone contraseña ni hash\", function () {",
                  "    pm.expect(cuerpo).to.not.include(\"password\");",
                  "    pm.expect(cuerpo).to.not.include(\"contrasena\");",
                  "    pm.expect(cuerpo).to.not.include(\"$2a$\");",
                  "});",
                  "pm.test(\"El rol asignado es USER\", function () {",
                  "    pm.expect(pm.response.json().rol).to.eql(\"USER\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar administrador de prueba (201, o 409 si ya existe)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Admin Prueba\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Registra la cuenta con rol USER. Después hay que promoverla a ADMIN en la base:\nUPDATE usuarios SET rol = 'ADMIN' WHERE email = 'admin.prueba@altokego.test';"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201, o 409 si ya estaba registrado\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "const cuerpo = pm.response.text();",
                  "pm.test(\"La respuesta no expone contraseña ni hash\", function () {",
                  "    pm.expect(cuerpo).to.not.include(\"password\");",
                  "    pm.expect(cuerpo).to.not.include(\"contrasena\");",
                  "    pm.expect(cuerpo).to.not.include(\"$2a$\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Repetir el correo de un usuario registrado (409)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Prueba\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Prueba que no se crea otro usuario con el mismo correo."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"El mensaje indica que el correo ya está en uso\", function () {",
                  "    pm.expect(pm.response.json().mensaje || pm.response.text()).to.include(\"ya está en uso\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar datos inválidos (400)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"email\": \"no-es-un-correo\",\n  \"password\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Intentar registrarse como ADMIN (queda como USER)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Intruso\",\n  \"email\": \"intruso@altokego.test\",\n  \"password\": \"intruso123\",\n  \"rol\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "El DTO de registro no tiene campo rol, así que el rol del JSON se ignora."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Se registra (201) o ya existía (409)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"El rol enviado en el JSON se ignora: queda USER\", function () {",
                  "        pm.expect(pm.response.json().rol).to.eql(\"USER\");",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
